@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<HelpDeskLive.MVC.SharedResource> Localizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isArabic = currentCulture == "ar";
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - @Localizer["AppName"]</title>

    @if (isArabic)
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    }

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    @Localizer["AppName"]
                </a>

                <div class="d-flex align-items-center gap-3">

                    <form asp-controller="Account"
                          asp-action="SetLanguage"
                          method="post"
                          class="d-flex align-items-center">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="returnUrl" value="@currentUrl" />

                        <select name="culture"
                                class="form-select form-select-sm"
                                onchange="this.form.submit()">

                            <option value="en" selected="@(currentCulture == "en")">
                                English
                            </option>

                            <option value="ar" selected="@(currentCulture == "ar")">
                                العربية
                            </option>

                        </select>
                    </form>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            @Localizer["Logout"]
                        </button>
                    </form>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
        @{
            var alertError = TempData["Error"] ?? TempData["AgentTicketError"] ?? TempData["TicketError"] ?? TempData["ErrorMessage"];
            var alertSuccess = TempData["Success"] ?? TempData["AgentTicketSuccess"] ?? TempData["TicketSuccess"] ?? TempData["SuccessMessage"];
        }

        @if (alertError != null || alertSuccess != null)
        {
            <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1200;">
                @if (alertError != null)
                {
                    <div id="globalErrorToast" class="toast align-items-center text-bg-danger border-0 show shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
                        <div class="d-flex">
                            <div class="toast-body d-flex align-items-center gap-2">
                                <div>
                                    <div class="fw-bold fs-6">@Localizer["Notice"]</div>
                                    <div>@alertError</div>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                }
                @if (alertSuccess != null)
                {
                    <div id="globalSuccessToast" class="toast align-items-center text-bg-success border-0 show shadow-lg" role="alert" aria-live="polite" aria-atomic="true" data-bs-delay="5000">
                        <div class="d-flex">
                            <div class="toast-body d-flex align-items-center gap-2">
                                <div>
                                    <div class="fw-bold fs-6">@Localizer["Success"]</div>
                                    <div>@alertSuccess</div>
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                }
            </div>
        }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - @Localizer["FooterCopyright"]
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard-progress.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var toastElList = [].slice.call(document.querySelectorAll('.toast'));
            toastElList.forEach(function (toastEl) {
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
            });
        });
    </script>
</body>
</html>

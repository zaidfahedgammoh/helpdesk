@model HelpDeskLive.MVC.Controllers.AdminTicketApprovalsPageModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["PendingCustomRequests"];
}
<div class="container py-4">
    <h2>@Localizer["PendingCustomRequests"]</h2>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">@Localizer["BackToDashboard"]</a>
    @if (TempData["ApprovalSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ApprovalError"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (Model.Requests.Count == 0) { <p class="text-muted">@Localizer["NoPendingCustomRequests"]</p> }
    @foreach (var request in Model.Requests)
    {
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
            <h5>@request.Title <small class="text-muted">#@request.Id</small></h5>
            <p>@request.Description</p>
            <p class="text-muted">@Localizer["Customer"] #@request.CustomerId · @request.CreatedAt.ToLocalTime().ToString("g")</p>
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@request.Id" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Priority"]</label>
                        <select name="priority" class="form-select">
                            <option value="1">@Localizer["Low"]</option><option value="2" selected>@Localizer["Medium"]</option>
                            <option value="3">@Localizer["High"]</option><option value="4">@Localizer["Critical"]</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@Localizer["Department"]</label>
                        <select name="departmentId" class="form-select" required>
                            <option value="">@Localizer["ChooseDepartment"]</option>
                            @foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">@Localizer["Approve"]</button></div>
                </div>
            </form>
            <form asp-action="Reject" method="post" class="mt-2">
                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@request.Id" />
                <button class="btn btn-outline-danger" type="submit">@Localizer["RejectRequest"]</button>
            </form>
        </div></div>
    }
</div>

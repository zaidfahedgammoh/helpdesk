@model List<HelpDeskLive.MVC.Controllers.AgentTicketRow>
@{ ViewData["Title"] = "My Assigned Tickets"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>My assigned tickets</h2><p class="text-muted">Tickets assigned to you from your department.</p></div><a asp-controller="Agent" asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a></div>
@if (TempData["AgentTicketSuccess"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["AgentTicketError"] is string error) { <div class="alert alert-danger">@error</div> }
@if (Model.Count == 0) { <p class="text-muted">No tickets are currently assigned to you.</p> }
@foreach (var ticket in Model) { <div class="card mb-3"><div class="card-body"><div class="d-flex justify-content-between"><h5>#@ticket.Id — @ticket.Title</h5><span class="badge text-bg-light">@ticket.Status</span></div><p>@ticket.Description</p><p class="small text-muted">Priority: @(ticket.Priority?.ToString() ?? "Not set") · Created: @ticket.CreatedAt.ToLocalTime().ToString("g")</p>
@if (ticket.Status == 1) { <form asp-action="Start" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id"/><button class="btn btn-primary">Start work</button></form> }
@if (ticket.Status == 2) { <form asp-action="Resolve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id"/><button class="btn btn-success">Mark resolved</button></form> }
@if (ticket.Status == 3) { <form asp-action="Close" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id"/><button class="btn btn-outline-secondary">Close ticket</button></form> }
</div></div> }
</div>

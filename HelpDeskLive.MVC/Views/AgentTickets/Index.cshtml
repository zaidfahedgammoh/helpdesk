@model List<HelpDeskLive.MVC.Controllers.AgentTicketRow>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["DepartmentQueue"];
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2>@Localizer["MyAssignedTickets"]</h2>
            <p class="text-muted mb-0">@Localizer["DepartmentQueueDescription"]</p>
        </div>
        <a asp-controller="Agent" asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackToDashboard"]</a>
    </div>
    @if (TempData["AgentTicketSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["AgentTicketError"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5">
            <h5>@Localizer["NoAssignedTickets"]</h5>
        </div></div>
    }
    @foreach (var ticket in Model)
    {
        var status = ticket.Status switch { 1 => Localizer["Open"].Value, 2 => Localizer["InProgress"].Value, 3 => Localizer["Resolved"].Value, 4 => Localizer["Closed"].Value, _ => ticket.Status.ToString() };
        var priority = ticket.Priority switch { 1 => Localizer["Low"].Value, 2 => Localizer["Medium"].Value, 3 => Localizer["High"].Value, 4 => Localizer["Critical"].Value, _ => Localizer["NotSet"].Value };
        <div class="card border-0 shadow-sm mb-3"><div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <h5>#@ticket.Id — @ticket.Title</h5><span class="badge text-bg-light">@status</span>
            </div>
            <p>@ticket.Description</p>
            <p class="small text-muted">@Localizer["Priority"]: @priority · @Localizer["CreatedAt"]: @ticket.CreatedAt.ToLocalTime().ToString("g")</p>
            @if (ticket.Status == 1)
            {
                @if (ticket.AssignedAgentId is null)
                {
                    <div class="small text-muted mb-2">@Localizer["WaitingInDepartmentQueue"]</div>
                }
                <form asp-action="Start" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id" /><button class="btn btn-primary">@Localizer["StartWork"]</button></form>
            }
            @if (ticket.Status == 2)
            {
                @if (ticket.Priority is 3 or 4)
                {
                    <a asp-action="Chat" asp-route-id="@ticket.Id" class="btn btn-primary">@Localizer["OpenLiveChat"]</a>
                }
                <form asp-action="Resolve" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id" /><button class="btn btn-success">@Localizer["MarkResolved"]</button></form>
            }
            @if (ticket.Status == 3)
            {
                <form asp-action="Close" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@ticket.Id" /><button class="btn btn-outline-secondary">@Localizer["CloseTicket"]</button></form>
            }
        </div></div>
    }
</div>
@section Scripts {
    <script src="~/js/agent-ticket-queue.js" asp-append-version="true"></script>
}

@model HelpDeskLive.MVC.Controllers.AdminIssueTypesViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["ManageIssueTypesTitle"];
}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div><h2 class="mb-1">@Localizer["ManageIssueTypesTitle"]</h2><p class="text-muted mb-0">@Localizer["IssueTypesDescription"]</p></div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackToDashboard"]</a>
    </div>
    @if (TempData["IssueTypeSuccess"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["IssueTypeError"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="row g-4">
        <div class="col-lg-7"><section class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="mb-3">@Localizer["ActiveIssueTypes"]</h5>
            @if (Model.IssueTypes.Count == 0) { <p class="text-muted mb-0">@Localizer["NoActiveIssueTypes"]</p> }
            else {
                <div class="table-responsive"><table class="table align-middle">
                    <thead><tr><th>@Localizer["Name"]</th><th>@Localizer["Description"]</th><th>@Localizer["Department"]</th><th>@Localizer["Priority"]</th></tr></thead>
                    <tbody>@foreach (var issue in Model.IssueTypes) {
                        var priorityLabel = issue.DefaultPriority switch { 1 => Localizer["Low"].Value, 2 => Localizer["Medium"].Value, 3 => Localizer["High"].Value, 4 => Localizer["Critical"].Value, _ => issue.DefaultPriority.ToString() };
                        <tr><td class="fw-semibold">@issue.Name</td><td>@issue.Description</td><td>@issue.DepartmentId</td><td>@priorityLabel</td></tr>
                    }</tbody>
                </table></div>
            }
        </div></section></div>
        <div class="col-lg-5"><section class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="mb-3">@Localizer["AddIssueType"]</h5>
            @if (Model.Departments.Count == 0) { <div class="alert alert-warning mb-0">@Localizer["CreateDepartmentsFirst"]</div> }
            else {
                <form asp-controller="AdminIssueTypes" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label" for="Name">@Localizer["Name"]</label><input class="form-control" id="Name" name="Name" maxlength="150" required/></div>
                    <div class="mb-3"><label class="form-label" for="Description">@Localizer["Description"]</label><textarea class="form-control" id="Description" name="Description" rows="3" maxlength="1000" required></textarea></div>
                    <div class="mb-3"><label class="form-label" for="DepartmentId">@Localizer["Department"]</label><select class="form-select" id="DepartmentId" name="DepartmentId" required><option value="">@Localizer["SelectDepartment"]</option>@foreach (var department in Model.Departments) { <option value="@department.Id">@department.Name</option> }</select></div>
                    <div class="mb-3"><label class="form-label" for="DefaultPriority">@Localizer["DefaultPriority"]</label><select class="form-select" id="DefaultPriority" name="DefaultPriority" required><option value="1">@Localizer["Low"]</option><option value="2" selected>@Localizer["Medium"]</option><option value="3">@Localizer["High"]</option><option value="4">@Localizer["Critical"]</option></select></div>
                    <button type="submit" class="btn btn-primary">@Localizer["AddIssueType"]</button>
                </form>
            }
        </div></section></div>
    </div>
</div>

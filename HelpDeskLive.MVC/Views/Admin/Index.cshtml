@model HelpDeskLive.MVC.Models.AdminDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AdminDashboard"];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Localizer["AdminDashboard"]</h2>
            <p class="text-muted mb-0">@Localizer["AdminWelcomeText"]</p>
        </div>
        <span class="badge text-bg-light px-3 py-2">@Localizer["Overview"]</span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["TotalTickets"]</div>
                <div class="display-6 fw-semibold">@Model.TotalTickets</div>
                <div class="small text-muted">@Localizer["AllTickets"]</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["OpenTickets"]</div>
                <div class="display-6 fw-semibold text-primary">@Model.OpenTickets</div>
                <div class="small text-muted">@Localizer["AwaitingWork"]</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["InProgressTickets"]</div>
                <div class="display-6 fw-semibold text-info">@Model.InProgressTickets</div>
                <div class="small text-muted">@Localizer["CurrentlyBeingHandled"]</div>
            </div></div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["ResolvedTickets"]</div>
                <div class="display-6 fw-semibold text-success">@Model.ResolvedTickets</div>
                <div class="small text-muted">@Localizer["ReadyForClosure"]</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body">
                    <div class="text-muted small">Average Resolution Time</div>
                    <div class="fs-2 fw-bold text-success">@Model.PerformanceStats.AverageResolutionTimeHours <span class="fs-6 fw-normal text-muted">hrs</span></div>
                    <div class="small text-muted">Based on @Model.PerformanceStats.TotalResolvedSample resolved tickets</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body">
                    <div class="text-muted small">Average Closing Time</div>
                    <div class="fs-2 fw-bold text-secondary">@Model.PerformanceStats.AverageClosingTimeHours <span class="fs-6 fw-normal text-muted">hrs</span></div>
                    <div class="small text-muted">Based on @Model.PerformanceStats.TotalClosedSample closed tickets</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body">
                    <div class="text-muted small">Total Escalations</div>
                    <div class="fs-2 fw-bold text-warning">@Model.EscalatedStats.TotalEscalations</div>
                    <div class="small text-muted">@Model.EscalatedStats.CurrentlyEscalatedTickets waiting in queue</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100 bg-light">
                <div class="card-body">
                    <div class="text-muted small">Reassigned Escalations</div>
                    <div class="fs-2 fw-bold text-info">@Model.EscalatedStats.ReassignedEscalations</div>
                    <div class="small text-muted">Avg @Model.EscalatedStats.AverageResolutionAfterEscalationHours hrs to resolve</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-1">@Localizer["TicketStatistics"]</h5>
                    <p class="text-muted small mb-4">@Localizer["TicketsByStatus"]</p>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@Localizer["Open"]</span><strong>@Model.OpenTickets</strong></div>
                        <div class="progress" role="progressbar" aria-label="Open tickets" aria-valuenow="@(Model.TotalTickets == 0 ? 0 : Model.OpenTickets * 100 / Model.TotalTickets)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-primary" data-progress="@(Model.TotalTickets == 0 ? 0 : Model.OpenTickets * 100 / Model.TotalTickets)"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@Localizer["InProgress"]</span><strong>@Model.InProgressTickets</strong></div>
                        <div class="progress" role="progressbar" aria-label="In progress tickets" aria-valuenow="@(Model.TotalTickets == 0 ? 0 : Model.InProgressTickets * 100 / Model.TotalTickets)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-info" data-progress="@(Model.TotalTickets == 0 ? 0 : Model.InProgressTickets * 100 / Model.TotalTickets)"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@Localizer["Resolved"]</span><strong>@Model.ResolvedTickets</strong></div>
                        <div class="progress" role="progressbar" aria-label="Resolved tickets" aria-valuenow="@(Model.TotalTickets == 0 ? 0 : Model.ResolvedTickets * 100 / Model.TotalTickets)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-success" data-progress="@(Model.TotalTickets == 0 ? 0 : Model.ResolvedTickets * 100 / Model.TotalTickets)"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between small mb-1"><span>@Localizer["Closed"]</span><strong>@Model.ClosedTickets</strong></div>
                        <div class="progress" role="progressbar" aria-label="Closed tickets" aria-valuenow="@(Model.TotalTickets == 0 ? 0 : Model.ClosedTickets * 100 / Model.TotalTickets)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-secondary" data-progress="@(Model.TotalTickets == 0 ? 0 : Model.ClosedTickets * 100 / Model.TotalTickets)"></div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="mb-3">@Localizer["People"]</h5>
                    <div class="d-flex justify-content-between align-items-center border-bottom py-3">
                        <span class="text-muted">@Localizer["TotalAgents"]</span>
                        <span class="fs-3 fw-semibold">@Model.TotalAgents</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted">@Localizer["TotalCustomers"]</span>
                        <span class="fs-3 fw-semibold">@Model.TotalCustomers</span>
                    </div>
                    <p class="small text-muted mt-3 mb-0">@Localizer["PeopleOverviewHint"]</p>
                </div>
            </section>
        </div>
    </div>

    @if (Model.DepartmentStats.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-3">@Localizer["DepartmentStatistics"]</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["Department"]</th>
                                <th>@Localizer["TotalTickets"]</th>
                                <th>@Localizer["Open"]</th>
                                <th>@Localizer["InProgress"]</th>
                                <th>@Localizer["Resolved"]</th>
                                <th>@Localizer["Closed"]</th>
                                <th>@Localizer["Escalated"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dept in Model.DepartmentStats)
                            {
                                <tr>
                                    <td class="fw-semibold">@dept.DepartmentName</td>
                                    <td><span class="badge text-bg-light">@dept.TotalTickets</span></td>
                                    <td><span class="text-primary">@dept.OpenTickets</span></td>
                                    <td><span class="text-info">@dept.InProgressTickets</span></td>
                                    <td><span class="text-success">@dept.ResolvedTickets</span></td>
                                    <td><span class="text-secondary">@dept.ClosedTickets</span></td>
                                    <td><span class="badge text-bg-warning">@dept.EscalatedTickets</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (Model.AgentStats.Count > 0)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-3">@Localizer["AgentPerformance"]</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["AgentName"]</th>
                                <th>@Localizer["Department"]</th>
                                <th>@Localizer["ActiveTickets"]</th>
                                <th>@Localizer["Resolved"]</th>
                                <th>@Localizer["Closed"]</th>
                                <th>@Localizer["TotalHandled"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var agent in Model.AgentStats)
                            {
                                <tr>
                                    <td class="fw-semibold">@agent.AgentName</td>
                                    <td class="text-muted">@agent.DepartmentName</td>
                                    <td><span class="badge text-bg-info">@agent.ActiveTickets</span></td>
                                    <td><span class="text-success fw-medium">@agent.ResolvedTickets</span></td>
                                    <td><span class="text-secondary fw-medium">@agent.ClosedTickets</span></td>
                                    <td><strong>@agent.TotalHandled</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <section class="card border-0 shadow-sm">
                <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h5 class="mb-1">@Localizer["AdminWorkspace"]</h5>
                        <p class="text-muted small mb-0">@Localizer["AdminWorkspaceHint"]</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-primary" asp-controller="AdminAccounts" asp-action="Index" asp-route-role="Customer">@Localizer["ManageCustomers"]</a>
                        <a class="btn btn-outline-primary" asp-controller="AdminAccounts" asp-action="Index" asp-route-role="Agent">@Localizer["ManageAgents"]</a>
                        <a class="btn btn-outline-primary" asp-controller="AdminIssueTypes" asp-action="Index">@Localizer["ManageIssueTypesAction"]</a>
                        <a class="btn btn-outline-primary" asp-controller="AdminTicketApprovals" asp-action="Index">@Localizer["ReviewCustomRequests"]</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>


@model HelpDeskLive.MVC.Models.AdminDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["AdminDashboard"];
}

<div class="container mt-4">
    <h2 class="mb-4">@Localizer["AdminDashboard"]</h2>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["TotalTickets"]</h6>
                    <h2>@Model.TotalTickets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["OpenTickets"]</h6>
                    <h2>@Model.OpenTickets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["InProgressTickets"]</h6>
                    <h2>@Model.InProgressTickets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["ResolvedTickets"]</h6>
                    <h2>@Model.ResolvedTickets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["ClosedTickets"]</h6>
                    <h2>@Model.ClosedTickets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["TotalAgents"]</h6>
                    <h2>@Model.TotalAgents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>@Localizer["TotalCustomers"]</h6>
                    <h2>@Model.TotalCustomers</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        @Localizer["TicketsByStatus"]
                    </h5>

                    <canvas id="ticketsStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const statusLabels = [
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["OpenStatus"].Value)),
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["InProgressStatus"].Value)),
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ResolvedStatus"].Value)),
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ClosedStatus"].Value))
    ];

    const statusCounts = [
        @Model.OpenTickets,
        @Model.InProgressTickets,
        @Model.ResolvedTickets,
        @Model.ClosedTickets
    ];

    const chartContext = document
        .getElementById("ticketsStatusChart");

    new Chart(chartContext, {
        type: "bar",

        data: {
            labels: statusLabels,

            datasets: [{
                label: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["NumberOfTickets"].Value)),
                data: statusCounts,
                borderWidth: 1
            }]
        },

        options: {
            responsive: true,

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            }
        }
    });
</script>

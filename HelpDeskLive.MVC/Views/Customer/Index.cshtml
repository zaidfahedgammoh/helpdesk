@model HelpDeskLive.MVC.Models.CustomerDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CustomerDashboard"];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Localizer["CustomerDashboard"]</h2>
            <p class="text-muted mb-0">@Localizer["CustomerWelcomeText"]</p>
        </div>
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createTicketModal">
            <i class="bi bi-plus-circle me-1"></i>@Localizer["CreateTicket"]
        </button>
    </div>

    @if (TempData["TicketSuccess"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["TicketError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["TotalTickets"]</div>
                <div class="fs-2 fw-semibold">@Model.TotalTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["OpenTickets"]</div>
                <div class="fs-2 fw-semibold text-primary">@Model.OpenTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["InProgressTickets"]</div>
                <div class="fs-2 fw-semibold text-info">@Model.InProgressTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["ResolvedTickets"]</div>
                <div class="fs-2 fw-semibold text-success">@Model.ResolvedTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["ClosedTickets"]</div>
                <div class="fs-2 fw-semibold">@Model.ClosedTickets</div>
            </div></div>
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 mb-0">@Localizer["MyTickets"]</h4>
                <span class="badge text-bg-light">@Model.TotalTickets</span>
            </div>

            @if (Model.Tickets.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-2"><i class="bi bi-inbox"></i></div>
                    <h5>@Localizer["NoTicketsFound"]</h5>
                    <p class="text-muted mb-0">@Localizer["CustomerWelcomeText"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["TicketNumber"]</th>
                                <th>@Localizer["TicketTitle"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Priority"]</th>
                                <th>@Localizer["CreatedAt"]</th>
                                <th>@Localizer["Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            var statusLabel = ticket.ApprovalStatus switch
                            {
                                1 => Localizer["PendingAdminApproval"].Value,
                                3 => Localizer["RequestRejected"].Value,
                                _ => ticket.Status switch
                                {
                                1 => Localizer["Open"].Value,
                                2 => Localizer["InProgress"].Value,
                                3 => Localizer["Resolved"].Value,
                                4 => Localizer["Closed"].Value,
                                5 => Localizer["Escalated"].Value,
                                _ => ticket.Status.ToString()
                                }
                            };
                            var priorityLabel = ticket.Priority switch
                            {
                                1 => Localizer["Low"].Value,
                                2 => Localizer["Medium"].Value,
                                3 => Localizer["High"].Value,
                                4 => Localizer["Critical"].Value,
                                _ => ticket.Priority?.ToString() ?? Localizer["NotSet"].Value
                            };
                            <tr>
                                <td class="text-muted">#@ticket.Id</td>
                                <td class="fw-medium">@ticket.Title</td>
                                <td>
                                    @if (ticket.Status == 5 && ticket.ApprovalStatus == 2)
                                    {
                                        <span class="badge rounded-pill text-bg-warning">@statusLabel</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-light">@statusLabel</span>
                                    }
                                </td>
                                <td>@priorityLabel</td>
                                <td class="text-muted">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    @if (ticket.ApprovalStatus == 2 && (ticket.Priority is 3 or 4) && (ticket.Status is 1 or 2))
                                    {
                                        <a asp-controller="Customer" asp-action="Chat" asp-route-id="@ticket.Id" class="btn btn-sm btn-primary">@Localizer["JoinChat"]</a>
                                        @if (ticket.AssignedAgentId is null)
                                        {
                                            <div class="small text-muted mt-1">@Localizer["WaitingForAgent"]</div>
                                        }
                                    }
                                    else if (ticket.Status == 5)
                                    {
                                        <div class="small text-warning fw-semibold mb-1">
                                            <i class="bi bi-arrow-up-right-circle me-1"></i>@Localizer["TicketEscalatedNotice"]
                                        </div>
                                    }
                                    @if (ticket.ApprovalStatus == 2 && ticket.Status is not (3 or 4))
                                    {
                                        <form asp-controller="Customer" asp-action="CloseTicket" method="post" class="mt-1" onsubmit="return confirm('@Localizer["ConfirmCloseTicket"]')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@ticket.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["CloseMyTicket"]</button>
                                        </form>
                                    }
                                    else if (ticket.ApprovalStatus == 1)
                                    {
                                        <span class="small text-muted">@Localizer["PendingAdminApproval"]</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <h4 class="h5 mb-1">@Localizer["AvailableIssueTypes"]</h4>
            <p class="text-muted small mb-3">@Localizer["ChooseIssueTypesHint"]</p>
            @if (Model.IssueTypes.Count == 0)
            {
                <p class="text-muted mb-0">@Localizer["NoDataAvailable"]</p>
            }
            else
            {
                <div class="row g-3">
                @foreach (var issue in Model.IssueTypes)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="border rounded-3 p-3 h-100">
                            @{
                                var issueKey = issue.Name switch
                                {
                                    "Password or Account Access" => "PasswordAccountAccess",
                                    "Software Problem" => "SoftwareProblem",
                                    "Computer or Hardware Problem" => "ComputerHardwareProblem",
                                    "Network or Wi-Fi Problem" => "NetworkWifiProblem",
                                    "Accounts and Billing Question" => "AccountsBillingQuestion",
                                    "Facilities or Office Problem" => "FacilitiesOfficeProblem",
                                    _ => string.Empty
                                };
                                var issueDescriptionKey = issueKey + "Desc";
                            }
                            <div class="fw-semibold mb-1">@(string.IsNullOrEmpty(issueKey) ? issue.Name : Localizer[issueKey].Value)</div>
                            <p class="text-muted small mb-0">@(string.IsNullOrEmpty(issueKey) ? issue.Description : Localizer[issueDescriptionKey].Value)</p>
                        </div>
                    </div>
                }
                    <div class="col-md-6 col-xl-4">
                        <div class="border border-dashed rounded-3 p-3 h-100">
                            <div class="fw-semibold mb-1">@Localizer["Other"]</div>
                            <p class="text-muted small mb-0">@Localizer["OtherIssueHint"]</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="Customer" asp-action="CreateTicket" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createTicketModalLabel">@Localizer["CreateTicket"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">@Localizer["ChooseIssueTypeHint"]</p>
                    <div class="mb-3">
                        <label for="IssueTypeId" class="form-label">@Localizer["IssueType"]</label>
                        <select id="IssueTypeId" name="IssueTypeId" class="form-select">
                            <option value="">@Localizer["OtherCustomRequest"]</option>
                            @foreach (var issue in Model.IssueTypes)
                            {
                                var optionKey = issue.Name switch
                                {
                                    "Password or Account Access" => "PasswordAccountAccess",
                                    "Software Problem" => "SoftwareProblem",
                                    "Computer or Hardware Problem" => "ComputerHardwareProblem",
                                    "Network or Wi-Fi Problem" => "NetworkWifiProblem",
                                    "Accounts and Billing Question" => "AccountsBillingQuestion",
                                    "Facilities or Office Problem" => "FacilitiesOfficeProblem",
                                    _ => string.Empty
                                };
                                <option value="@issue.Id">@(string.IsNullOrEmpty(optionKey) ? issue.Name : Localizer[optionKey].Value)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="customTitleContainer" hidden>
                        <label for="CustomTitle" class="form-label">@Localizer["CustomTitleOnlyOther"]</label>
                        <input id="CustomTitle" name="CustomTitle" class="form-control" maxlength="200" placeholder="@Localizer["SummarizeIssue"]" />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">@Localizer["DescribeIssue"]</label>
                        <textarea id="Description" name="Description" class="form-control" rows="4" maxlength="5000" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@Localizer["SubmitTicket"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/customer-dashboard.js" asp-append-version="true"></script>
}

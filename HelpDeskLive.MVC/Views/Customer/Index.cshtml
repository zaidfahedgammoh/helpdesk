@model HelpDeskLive.MVC.Models.CustomerDashboardViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CustomerDashboard"];
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Localizer["CustomerDashboard"]</h2>
            <p class="text-muted mb-0">@Localizer["CustomerWelcomeText"]</p>
        </div>
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#createTicketModal">
            <i class="bi bi-plus-circle me-1"></i>@Localizer["CreateTicket"]
        </button>
    </div>

    @if (TempData["TicketSuccess"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["TicketError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["TotalTickets"]</div>
                <div class="fs-2 fw-semibold">@Model.TotalTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["OpenTickets"]</div>
                <div class="fs-2 fw-semibold text-primary">@Model.OpenTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["InProgressTickets"]</div>
                <div class="fs-2 fw-semibold text-info">@Model.InProgressTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["ResolvedTickets"]</div>
                <div class="fs-2 fw-semibold text-success">@Model.ResolvedTickets</div>
            </div></div>
        </div>
        <div class="col-6 col-lg">
            <div class="card border-0 shadow-sm h-100"><div class="card-body">
                <div class="text-muted small">@Localizer["ClosedTickets"]</div>
                <div class="fs-2 fw-semibold">@Model.ClosedTickets</div>
            </div></div>
        </div>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="h5 mb-0">@Localizer["MyTickets"]</h4>
                <span class="badge text-bg-light">@Model.TotalTickets</span>
            </div>

            @if (Model.Tickets.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-2"><i class="bi bi-inbox"></i></div>
                    <h5>@Localizer["NoTicketsFound"]</h5>
                    <p class="text-muted mb-0">@Localizer["CustomerWelcomeText"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Localizer["TicketNumber"]</th>
                                <th>@Localizer["TicketTitle"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["Priority"]</th>
                                <th>@Localizer["CreatedAt"]</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            var statusLabel = ticket.ApprovalStatus switch
                            {
                                1 => "Pending Admin approval",
                                3 => "Request rejected",
                                _ => ticket.Status switch
                                {
                                1 => Localizer["Open"].Value,
                                2 => Localizer["InProgress"].Value,
                                3 => Localizer["Resolved"].Value,
                                4 => Localizer["Closed"].Value,
                                _ => ticket.Status.ToString()
                                }
                            };
                            var priorityLabel = ticket.Priority switch
                            {
                                1 => Localizer["Low"].Value,
                                2 => Localizer["Medium"].Value,
                                3 => Localizer["High"].Value,
                                4 => Localizer["Critical"].Value,
                                _ => ticket.Priority?.ToString() ?? "Not set"
                            };
                            <tr>
                                <td class="text-muted">#@ticket.Id</td>
                                <td class="fw-medium">@ticket.Title</td>
                                <td><span class="badge rounded-pill text-bg-light">@statusLabel</span></td>
                                <td>@priorityLabel</td>
                                <td class="text-muted">@ticket.CreatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <h4 class="h5 mb-1">Available issue types</h4>
            <p class="text-muted small mb-3">Choose Create Ticket to submit one of these issues.</p>
            @if (Model.IssueTypes.Count == 0)
            {
                <p class="text-muted mb-0">@Localizer["NoDataAvailable"]</p>
            }
            else
            {
                <div class="row g-3">
                @foreach (var issue in Model.IssueTypes)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="fw-semibold mb-1">@issue.Name</div>
                            <p class="text-muted small mb-0">@issue.Description</p>
                        </div>
                    </div>
                }
                    <div class="col-md-6 col-xl-4">
                        <div class="border border-dashed rounded-3 p-3 h-100">
                            <div class="fw-semibold mb-1">@Localizer["Other"]</div>
                            <p class="text-muted small mb-0">Choose Other in the form to submit a custom request for Admin approval.</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form asp-controller="Customer" asp-action="CreateTicket" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createTicketModalLabel">@Localizer["CreateTicket"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Choose a predefined issue or leave the issue type on Other and enter a title. Custom requests require Admin approval.</p>
                    <div class="mb-3">
                        <label for="IssueTypeId" class="form-label">Issue type</label>
                        <select id="IssueTypeId" name="IssueTypeId" class="form-select">
                            <option value="">Other — custom request</option>
                            @foreach (var issue in Model.IssueTypes)
                            {
                                <option value="@issue.Id">@issue.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3" id="customTitleContainer" hidden>
                        <label for="CustomTitle" class="form-label">Issue title</label>
                        <input id="CustomTitle" name="CustomTitle" class="form-control" maxlength="200" placeholder="Summarize your issue" />
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Describe your issue</label>
                        <textarea id="Description" name="Description" class="form-control" rows="4" maxlength="5000" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    (() => {
        const issueTypeSelect = document.getElementById("IssueTypeId");
        const customTitleContainer = document.getElementById("customTitleContainer");
        const customTitleInput = document.getElementById("CustomTitle");

        if (!issueTypeSelect || !customTitleContainer || !customTitleInput) return;

        const updateCustomTitleVisibility = () => {
            const isCustomRequest = issueTypeSelect.value === "";
            customTitleContainer.hidden = !isCustomRequest;
            customTitleInput.required = isCustomRequest;

            if (!isCustomRequest) {
                customTitleInput.value = "";
            }
        };

        issueTypeSelect.addEventListener("change", updateCustomTitleVisibility);
        updateCustomTitleVisibility();
    })();
</script>

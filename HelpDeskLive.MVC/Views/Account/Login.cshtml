
@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Sign In | HelpDesk Live</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/login.css"
          asp-append-version="true" />
</head>

<body>
    <main class="login-wrapper">
        <section class="login-card">

            <h1 class="h3 fw-bold mb-2">Welcome</h1>

            <p class="subtitle mb-4">
                Sign in to your HelpDesk Live account.
            </p>

            <form id="login-form"
                  asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email" class="form-label">
                        Email address
                    </label>

                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           placeholder="Enter your email"
                           autocomplete="username"
                           required />
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">
                        Password
                    </label>

                    <div class="password-container">
                        <input type="password"
                               id="password"
                               name="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                id="toggle-password"
                                class="toggle-password">
                            Show
                        </button>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <button type="submit"
                        id="login-button"
                        class="btn-login">
                    Sign in
                </button>
            </form>

            <p class="text-center text-secondary small mt-4 mb-0">
                HelpDesk Live &copy; @DateTime.Now.Year
            </p>

        </section>
    </main>

    <script src="~/js/login.js"
            asp-append-version="true"></script>
</body>
</html>
